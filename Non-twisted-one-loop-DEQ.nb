          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "]"}]}], "-", 
        RowBox[{"i", "[", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "]"}], "-", 
        RowBox[{
         SuperscriptBox["p", "2"], " ", 
         RowBox[{"i", "[", 
          RowBox[{"1", ",", "1"}], "]"}]}]}], ")"}]}]}], "\[Tau]p"]}], 
  "}"}]], "Output",

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Total\[Psi]TimeDerivativeA", "[", 
    RowBox[{"n1_", ",", "n2_", ",", "sa_", ",", "sb_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"sa", "+", "\[Alpha]a", "-", "1"}], ")"}], "*", 
     RowBox[{"\[Psi]", "[", 
      RowBox[{"n1", ",", "n2", ",", "sa", ",", "sb"}], "]"}]}], "+", 
    RowBox[{"I", "*", "Xa", "*", 
     RowBox[{"\[Psi]", "[", 
      RowBox[{"n1", ",", "n2", ",", 
       RowBox[{"sa", "-", "1"}], ",", "sb"}], "]"}]}], "+", 
    RowBox[{"I", "*", 
     RowBox[{"\[Psi]", "[", 
      RowBox[{
       RowBox[{"n1", "-", "1"}], ",", "n2", ",", 
       RowBox[{"sa", "-", "1"}], ",", "sb"}], "]"}]}], "+", 
    RowBox[{"I", "*", 
     RowBox[{"\[Psi]", "[", 
      RowBox[{"n1", ",", 
       RowBox[{"n2", "-", "1"}], ",", 
       RowBox[{"sa", "-", "1"}], ",", "sb"}], "]"}]}], "-", 
    RowBox[{"F", "[", 
     RowBox[{"n1", ",", "n2", ",", "sa", ",", "sb"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Total\[Psi]TimeDerivativeB", "[", 
    RowBox[{"n1_", ",", "n2_", ",", "sa_", ",", "sb_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"sb", "+", "\[Alpha]b", "-", "1"}], ")"}], "*", 
     RowBox[{"\[Psi]", "[", 
      RowBox[{"n1", ",", "n2", ",", "sa", ",", "sb"}], "]"}]}], "+", 
    RowBox[{"I", "*", "Xb", "*", 
     RowBox[{"\[Psi]", "[", 
      RowBox[{"n1", ",", "n2", ",", "sa", ",", 
       RowBox[{"sb", "-", "1"}]}], "]"}]}], "-", 
    RowBox[{"I", "*", 
     RowBox[{"\[Psi]", "[", 
      RowBox[{
       RowBox[{"n1", "-", "1"}], ",", "n2", ",", "sa", ",", 
       RowBox[{"sb", "-", "1"}]}], "]"}]}], "+", 
    RowBox[{"I", "*", 
     RowBox[{"\[Psi]", "[", 
      RowBox[{"n1", ",", 
       RowBox[{"n2", "-", "1"}], ",", "sa", ",", 

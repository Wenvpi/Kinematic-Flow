      RowBox[{"i", "[", 
       RowBox[{"0", ",", 
        RowBox[{"-", "1"}]}], "]"}]}], "+", 
     RowBox[{
      SuperscriptBox["p", "2"], " ", "\[Tau]p", " ", 

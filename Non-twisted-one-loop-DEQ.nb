Cell[TextData[{
 "Therefore, apparently, we need to use other equations. Let us define the \
following function which searches for specific integrals. For example, for \
what value ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           SubscriptBox[
            StyleBox["n", "TI"], "1"], ",", 
           SubscriptBox[
            StyleBox["n", "TI"], "2"]}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(n_1,n_2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2e3e4cba-9606-4844-a24c-046644bbacc3"],
 " (where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["n", "TI"], "1"], ",", 
         SubscriptBox[
          StyleBox["n", "TI"], "2"], "\[Element]", 
         RowBox[{"{", 
           RowBox[{"-2", ",", "-1", ",", "0", ",", "1", ",", "2"}], "}"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "n_1,n_2\\in\\{-2,-1,0,1,2\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ff6752e2-b0c1-4f97-a386-461bf22dabd3"],
 ") we obtain ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["I", "TI"], 
        RowBox[{"0", ",", "-1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "I_{0,-1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a07c17d8-c1d0-4e0c-92f0-29e0265fc8b3"],
 " from the first total derivative relation"
}], "Text",
 CellChangeTimes->{{3.971896787625102*^9, 3.971896810812643*^9}, {
  3.971896854259069*^9, 3.9718968943423643`*^9}, {3.971954910325181*^9, 
  3.97195491518804*^9}},ExpressionUUID->"53b34916-d6f7-4b92-8955-\
437e211ae5fa"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"inputSet", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "2"}], ",", 
     RowBox[{"-", "1"}], ",", "0", ",", "1", ",", "2"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"allPairs", "=", 
   RowBox[{"Tuples", "[", 
    RowBox[{"inputSet", ",", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Select", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"#1", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"#1", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", 
       RowBox[{"TotalDerivative1", "[", 
        RowBox[{
         RowBox[{"#1", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"#1", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "}"}], "&"}], "/@", 
    "allPairs"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"Count", "[", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "3", "]"}], "]"}], ",", 
       RowBox[{"i", "[", 
        RowBox[{"0", ",", 
         RowBox[{"-", "1"}]}], "]"}], ",", "Infinity"}], "]"}], ">", "0"}], 
    "&"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.971895874775428*^9, 3.971895971256365*^9}, {
   3.971896400284726*^9, 3.971896407698608*^9}, {3.971896469512906*^9, 
   3.9718964701961393`*^9}, 3.971896518287406*^9, {3.971896607508123*^9, 
   3.971896610327838*^9}, {3.971896829923451*^9, 3.971896830197648*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"967dfbfd-cef8-4b82-94b0-b2baf37d1cc2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", 

        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", "\[Tau]m"]}], "-", 
          FractionBox["\[Tau]m", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["\[Tau]m", "2"], "-", 
              SuperscriptBox["\[Tau]p", "2"]}], ")"}]}]], "+", 
          FractionBox[
           RowBox[{"d", " ", "\[Tau]m"}], 
           RowBox[{
            SuperscriptBox["\[Tau]m", "2"], "-", 
            SuperscriptBox["\[Tau]p", "2"]}]], "-", 
          FractionBox[
           SuperscriptBox["\[Tau]p", "2"], 
           RowBox[{"\[Tau]m", " ", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["\[Tau]m", "2"], "-", 
              SuperscriptBox["\[Tau]p", "2"]}], ")"}]}]]}], ")"}], " ", 
        RowBox[{"i", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "]"}]}], "+", 
       FractionBox[
        RowBox[{"d", " ", "\[Tau]p", " ", 
         RowBox[{"i", "[", 
          RowBox[{"0", ",", "0"}], "]"}]}], 
        RowBox[{
         SuperscriptBox["\[Tau]m", "2"], "-", 
         SuperscriptBox["\[Tau]p", "2"]}]], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox["1", "\[Tau]m"], "-", 
          FractionBox[
           RowBox[{"2", " ", "d"}], "\[Tau]m"], "-", 
          FractionBox["\[Tau]m", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["\[Tau]m", "2"], "-", 
              SuperscriptBox["\[Tau]p", "2"]}], ")"}]}]], "+", 
          FractionBox[
           SuperscriptBox["\[Tau]p", "2"], 
           RowBox[{"\[Tau]m", " ", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["\[Tau]m", "2"], "-", 
              SuperscriptBox["\[Tau]p", "2"]}], ")"}]}]], "-", 
          FractionBox[
           RowBox[{"2", " ", "d", " ", 
            SuperscriptBox["\[Tau]p", "2"]}], 
           RowBox[{"\[Tau]m", " ", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["\[Tau]m", "2"], "-", 
              SuperscriptBox["\[Tau]p", "2"]}], ")"}]}]]}], ")"}], " ", 
        RowBox[{"i", "[", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "]"}]}], "+", 
       RowBox[{"\[ImaginaryI]", " ", 
        SuperscriptBox["p", "2"], " ", 
        RowBox[{"i", "[", 
         RowBox[{"1", ",", "0"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           SuperscriptBox["p", "2"], "\[Tau]m"], "-", 
          FractionBox[
           RowBox[{
            SuperscriptBox["p", "2"], " ", "\[Tau]m"}], 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["\[Tau]m", "2"], "-", 
              SuperscriptBox["\[Tau]p", "2"]}], ")"}]}]], "+", 
          FractionBox[
           RowBox[{
            SuperscriptBox["p", "2"], " ", 
            SuperscriptBox["\[Tau]p", "2"]}], 
           RowBox[{"\[Tau]m", " ", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["\[Tau]m", "2"], "-", 
              SuperscriptBox["\[Tau]p", "2"]}], ")"}]}]]}], ")"}], " ", 
        RowBox[{"i", "[", 
         RowBox[{"1", ",", "1"}], "]"}]}]}], ")"}]}]}]}], ";"}]}], "Input",

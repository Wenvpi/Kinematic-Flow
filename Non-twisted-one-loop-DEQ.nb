    RowBox[{
     RowBox[{"(", 
      RowBox[{"d", "-", "n1", "-", 
       FractionBox["n2", "2"]}], ")"}], "*", 
     RowBox[{"\[Psi]", "[", 
      RowBox[{"n1", ",", "n2", ",", "sa", ",", "sb"}], "]"}]}], "-", 
    RowBox[{"I", "*", 
     RowBox[{"\[Psi]", "[", 
      RowBox[{
       RowBox[{"n1", "-", "1"}], ",", "n2", ",", 

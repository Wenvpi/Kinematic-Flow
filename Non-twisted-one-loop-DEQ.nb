Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"i", "[", 
    RowBox[{
     RowBox[{"-", "2"}], ",", "1"}], "]"}], "\[Rule]", 
   FractionBox[
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], " ", "\[Tau]p", " ", 
      RowBox[{"i", "[", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "0"}], "]"}]}], "-", 

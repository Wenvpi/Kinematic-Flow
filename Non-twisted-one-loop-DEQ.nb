Notebook[{

Cell[CellGroupData[{
Cell["Non-twisted differential equations for one-loop diagram", "Title",
 CellChangeTimes->{{3.9710197756201963`*^9, 
  3.9710197873781977`*^9}},ExpressionUUID->"d7b430c9-cbe1-4c1d-8c2d-\
46736381f8ff"],

Cell[CellGroupData[{

Cell["Setup", "Section",
 CellChangeTimes->{{3.971883060813489*^9, 
  3.971883062095743*^9}},ExpressionUUID->"6b0f36c8-ff00-4543-ac91-\
1e8dcbf8f478"],

Cell[TextData[{
 "The momentum-derivative, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       FractionBox[
        RowBox[{"\[PartialD]", 
          SubscriptBox[
           StyleBox["I", "TI"], 
           RowBox[{
             SubscriptBox[
              StyleBox["n", "TI"], "1"], ",", 
             SubscriptBox[
              StyleBox["n", "TI"], "2"]}]]}], 
        RowBox[{"\[PartialD]", 
          StyleBox["p", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{\\partial I_{n_1,n_2}}{\\partial p}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f21df819-f5f5-4458-bbeb-70d2da45a23b"],
 ", is given, originally, by"
}], "Text",
 CellChangeTimes->{{3.971019854755026*^9, 3.971019885384246*^9}, {
  3.971952573462186*^9, 
  3.971952575292858*^9}},ExpressionUUID->"42c121ca-de42-472b-8e56-\
bec7ba665351"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ipOG", "[", 
    RowBox[{"n1_", ",", "n2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["n2", 
       RowBox[{"2", "*", "p"}]]}], 
     RowBox[{"i", "[", 
      RowBox[{"n1", ",", "n2"}], "]"}]}], "-", 
    RowBox[{
     FractionBox[
      RowBox[{"p", "*", "n2"}], "2"], 
     RowBox[{"i", "[", 
      RowBox[{"n1", ",", 
       RowBox[{"n2", "+", "2"}]}], "]"}]}], "+", 
    RowBox[{"I", "*", 
     FractionBox[
      RowBox[{"p", "*", "\[Tau]m"}], "2"], 
     RowBox[{"i", "[", 
      RowBox[{"n1", ",", 
       RowBox[{"n2", "+", "1"}]}], "]"}]}], "+", 
    RowBox[{"I", "*", 
     FractionBox["\[Tau]m", 
      RowBox[{"2", "*", "p"}]], 
     RowBox[{"i", "[", 
      RowBox[{"n1", ",", 
       RowBox[{"n2", "-", "1"}]}], "]"}]}], "+", 
    RowBox[{
     FractionBox["n2", 
      RowBox[{"2", "*", "p"}]], 
     RowBox[{"i", "[", 
      RowBox[{
       RowBox[{"n1", "-", "2"}], ",", 
       RowBox[{"n2", "+", "2"}]}], "]"}]}], "-", 
    RowBox[{"I", "*", 
     FractionBox["\[Tau]m", 
      RowBox[{"2", "*", "p"}]], 
     RowBox[{"i", "[", 
      RowBox[{
       RowBox[{"n1", "-", "2"}], ",", 
       RowBox[{"n2", "+", "1"}]}], "]"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.971019819425345*^9, 3.971019830094634*^9}, {
  3.97101989150029*^9, 3.971020058811339*^9}, {3.971024580934112*^9, 
  3.971024581967317*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"0b7470bc-6113-46bf-b205-8d937a2c174b"],

Cell["and we have the total derivative relations:", "Text",
 CellChangeTimes->{{3.971020112927503*^9, 3.97102011756627*^9}, {
  3.9719525792092*^9, 
  3.971952580991517*^9}},ExpressionUUID->"b44a04cc-3f4f-4b14-b18b-\
d65178d0374e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"TotalDerivative1", "[", 
    RowBox[{"n1_", ",", "n2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"d", "-", "n1", "-", 
       FractionBox["n2", "2"]}], ")"}], 
     RowBox[{"i", "[", 
      RowBox[{"n1", ",", "n2"}], "]"}]}], "+", 
    RowBox[{"I", "*", "\[Tau]p", "*", 
     RowBox[{"i", "[", 
      RowBox[{
       RowBox[{"n1", "-", "1"}], ",", "n2"}], "]"}]}], "+", 
    RowBox[{"I", "*", 
     FractionBox["\[Tau]m", "2"], 
     RowBox[{"i", "[", 
      RowBox[{"n1", ",", 
       RowBox[{"n2", "-", "1"}]}], "]"}]}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox["p", "2"], "*", "n2"}], "2"], 
     RowBox[{"i", "[", 
      RowBox[{"n1", ",", 
       RowBox[{"n2", "+", "2"}]}], "]"}]}], "-", 
    RowBox[{"I", "*", 
     FractionBox[
      RowBox[{
       SuperscriptBox["p", "2"], "*", "\[Tau]m"}], "2"], 
     RowBox[{"i", "[", 
      RowBox[{"n1", ",", 
       RowBox[{"n2", "+", "1"}]}], "]"}]}], "-", 
    RowBox[{
     FractionBox["n2", "2"], 
     RowBox[{"i", "[", 
      RowBox[{
       RowBox[{"n1", "-", "2"}], ",", 
       RowBox[{"n2", "+", "2"}]}], "]"}]}], "+", 
    RowBox[{"I", "*", 
     FractionBox["\[Tau]m", "2"], 
     RowBox[{"i", "[", 
      RowBox[{
       RowBox[{"n1", "-", "2"}], ",", 
       RowBox[{"n2", "+", "1"}]}], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TotalDerivative2", "[", 
    RowBox[{"n1_", ",", "n2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"d", "-", 
       FractionBox["n1", "2"], "-", "n2"}], ")"}], 
     RowBox[{"i", "[", 
      RowBox[{"n1", ",", "n2"}], "]"}]}], "+", 
    RowBox[{"I", "*", "\[Tau]m", "*", 
     RowBox[{"i", "[", 
      RowBox[{"n1", ",", 
       RowBox[{"n2", "-", "1"}]}], "]"}]}], "+", 
    RowBox[{"I", "*", 
     FractionBox["\[Tau]p", "2"], 
     RowBox[{"i", "[", 
      RowBox[{
       RowBox[{"n1", "-", "1"}], ",", "n2"}], "]"}]}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox["p", "2"], "*", "n1"}], "2"], 
     RowBox[{"i", "[", 
      RowBox[{
       RowBox[{"n1", "+", "2"}], ",", "n2"}], "]"}]}], "-", 
    RowBox[{"I", "*", 
     FractionBox[
      RowBox[{
       SuperscriptBox["p", "2"], "*", "\[Tau]p"}], "2"], 
     RowBox[{"i", "[", 
      RowBox[{
       RowBox[{"n1", "+", "1"}], ",", "n2"}], "]"}]}], "-", 
    RowBox[{
     FractionBox["n2", "2"], 
     RowBox[{"i", "[", 
      RowBox[{
       RowBox[{"n1", "+", "2"}], ",", 
       RowBox[{"n2", "-", "2"}]}], "]"}]}], "+", 
    RowBox[{"I", "*", 
     FractionBox["\[Tau]p", "2"], 
     RowBox[{"i", "[", 
      RowBox[{
       RowBox[{"n1", "+", "1"}], ",", 
       RowBox[{"n2", "-", "2"}]}], "]"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.971020131788583*^9, 3.971020303360991*^9}, {
  3.971022319837036*^9, 3.971022351327392*^9}, {3.971024498372348*^9, 
  3.971024505226706*^9}, {3.9710260362035427`*^9, 3.9710261146766987`*^9}, {
  3.971875264130094*^9, 3.9718752790977793`*^9}, {3.971883416266334*^9, 
  3.971883417076208*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"9f646794-d89d-40ae-94d5-ae0e13fc9f9f"],

Cell[TextData[{
 "Thus, adding this total derivative (which is set up to zero) to the \
momentum-derivative, we obtain a ",
 StyleBox["much simpler expression",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.971022523349325*^9, 3.971022554641114*^9}, {
  3.971952587863329*^9, 
  3.971952588522786*^9}},ExpressionUUID->"e2637dde-f7f8-4381-9f85-\
f7f217d46266"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Collect", "[", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"ipOG", "[", 
      RowBox[{"n1", ",", "n2"}], "]"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "p"}], ")"}], "*", 
      RowBox[{"TotalDerivative1", "[", 
       RowBox[{"n1", ",", "n2"}], "]"}]}]}], "]"}], ",", "i"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.971029042721718*^9, 3.9710290428162613`*^9}, {
  3.971029098300379*^9, 3.9710291004896317`*^9}},
 CellLabel->"In[70]:=",ExpressionUUID->"8971d655-0a79-4f9d-9778-4245db7780fe"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"\[ImaginaryI]", " ", "\[Tau]p", " ", 
    RowBox[{"i", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "1"}], "+", "n1"}], ",", "n2"}], "]"}]}], "+", 
   RowBox[{"\[ImaginaryI]", " ", "\[Tau]m", " ", 
    RowBox[{"i", "[", 
     RowBox[{"n1", ",", 
      RowBox[{
       RowBox[{"-", "1"}], "+", "n2"}]}], "]"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"d", "-", "n1", "-", "n2"}], ")"}], " ", 
    RowBox[{"i", "[", 
     RowBox[{"n1", ",", "n2"}], "]"}]}]}], "p"]], "Output",
 CellChangeTimes->{3.971029043212221*^9, 3.9710291007341337`*^9},
 CellLabel->"Out[70]=",ExpressionUUID->"880ab24b-3654-44ea-8b48-debd48f201a8"]
}, Open  ]],

Cell["which is the one we will use,", "Text",
 CellChangeTimes->{{3.971952598848687*^9, 
  3.9719526044190693`*^9}},ExpressionUUID->"ab44a661-ee45-4e21-8ea9-\
fb57d06dc129"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ip", "[", 
    RowBox[{"n1_", ",", "n2_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{
     RowBox[{"\[ImaginaryI]", " ", "\[Tau]p", " ", 
      RowBox[{"i", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "+", "n1"}], ",", "n2"}], "]"}]}], "+", 
     RowBox[{"\[ImaginaryI]", " ", "\[Tau]m", " ", 
      RowBox[{"i", "[", 
       RowBox[{"n1", ",", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n2"}]}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"d", "-", "n1", "-", "n2"}], ")"}], " ", 
      RowBox[{"i", "[", 
       RowBox[{"n1", ",", "n2"}], "]"}]}]}], "p"]}], ";"}]], "Input",
 CellChangeTimes->{{3.971024600041041*^9, 3.971024611041543*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"3b02969f-c9c4-4bcf-91a0-2587c2a0efd2"],

Cell[CellGroupData[{

Cell[TextData[{
 "Useful expressions for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Tau]", "+", "2"], 
         SubsuperscriptBox["\[NotEqual]\[Tau]", "-", "2"]}], TraditionalForm],
      "errors" -> {}, "input" -> "\\tau_+^2 \\neq \\tau_-^2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4f93b3a3-10d1-4d60-b319-47ca4fd5133b"]
}], "Subsection",
 CellChangeTimes->{{3.97188307493869*^9, 
  3.971883101502368*^9}},ExpressionUUID->"cb5fc6c5-d44b-454f-b92f-\
c0c9882fa38d"],

Cell[TextData[{
 "In the following section ",
 StyleBox["Closed differential equation system for ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Tau]", "+", "2"], 
         SubsuperscriptBox["\[NotEqual]\[Tau]", "-", "2"]}], TraditionalForm],
      "errors" -> {}, "input" -> "\\tau_+^2\\neq\\tau_-^2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7984552e-3aa5-4370-8724-663d71b8e1fa"],
 ", we obtained the following useful expression for the annoying integrals \
(that we want to express in terms of the closed family)"
}], "Text",
 CellChangeTimes->{{3.971952622429666*^9, 
  3.97195271411587*^9}},ExpressionUUID->"e2e389c9-74fd-4d42-895f-\
c594f0ee3597"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"iMTwoOne", ",", "iMOneZero", ",", "iOneMTwo", ",", "iZeroMOne"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"iMTwoOne", "[", 
     RowBox[{"p_", ",", "\[Tau]p_", ",", "\[Tau]m_"}], "]"}], ":=", 
    FractionBox[
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], " ", "\[Tau]m", " ", 
       RowBox[{"i", "[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "0"}], "]"}]}], "-", 
      RowBox[{"\[Tau]p", " ", 
       RowBox[{"i", "[", 
        RowBox[{"0", ",", 
         RowBox[{"-", "1"}]}], "]"}]}], "+", 
      RowBox[{
       SuperscriptBox["p", "2"], " ", "\[Tau]p", " ", 
       RowBox[{"i", "[", 
        RowBox[{"0", ",", "1"}], "]"}]}], "+", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"i", "[", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "]"}]}], "+", 
         RowBox[{"2", " ", "d", " ", 
          RowBox[{"i", "[", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "]"}]}], "-", 
         RowBox[{"i", "[", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}]}], "]"}], "-", 
         RowBox[{
          SuperscriptBox["p", "2"], " ", 
          RowBox[{"i", "[", 
           RowBox[{"1", ",", "1"}], "]"}]}]}], ")"}]}]}], "\[Tau]p"]}], ";"}],
   " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Valid", " ", "for", " ", 
     SuperscriptBox["\[Tau]p", "2"]}], " ", "=", " ", 
    RowBox[{
     SuperscriptBox["\[Tau]m", "2"], " ", "as", " ", "well"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"iMOneZero", "[", 
    RowBox[{"p_", ",", "\[Tau]p_", ",", "\[Tau]m_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{"\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[Tau]m"}], " ", 
        RowBox[{"i", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "]"}]}], "+", 
       RowBox[{"2", " ", "d", " ", "\[Tau]m", " ", 
        RowBox[{"i", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "]"}]}], "-", 
       RowBox[{"2", " ", "d", " ", "\[Tau]p", " ", 
        RowBox[{"i", "[", 
         RowBox[{"0", ",", "0"}], "]"}]}], "-", 
       RowBox[{"\[Tau]m", " ", 
        RowBox[{"i", "[", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "]"}]}], "-", 
       RowBox[{
        SuperscriptBox["p", "2"], " ", "\[Tau]m", " ", 
        RowBox[{"i", "[", 
         RowBox[{"1", ",", "1"}], "]"}]}]}], ")"}]}], 
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[Tau]m", "2"], "-", 
       SuperscriptBox["\[Tau]p", "2"]}], ")"}]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"iOneMTwo", "[", 
     RowBox[{"p_", ",", "\[Tau]p_", ",", "\[Tau]m_"}], "]"}], ":=", 
    FractionBox[
     RowBox[{
      RowBox[{
       RowBox[{"-", "\[Tau]m"}], " ", 
       RowBox[{"i", "[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "0"}], "]"}]}], "-", 
      RowBox[{"2", " ", "\[Tau]p", " ", 
       RowBox[{"i", "[", 
        RowBox[{"0", ",", 
         RowBox[{"-", "1"}]}], "]"}]}], "+", 
      RowBox[{
       SuperscriptBox["p", "2"], " ", "\[Tau]m", " ", 
       RowBox[{"i", "[", 
        RowBox[{"1", ",", "0"}], "]"}]}], "+", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"i", "[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "]"}], "-", 
         RowBox[{"i", "[", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}]}], "]"}], "+", 
         RowBox[{"2", " ", "d", " ", 
          RowBox[{"i", "[", 
           RowBox[{"1", ",", 
            RowBox[{"-", "1"}]}], "]"}]}], "-", 
         RowBox[{
          SuperscriptBox["p", "2"], " ", 
          RowBox[{"i", "[", 
           RowBox[{"1", ",", "1"}], "]"}]}]}], ")"}]}]}], "\[Tau]m"]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Valid", " ", "for", " ", 
     SuperscriptBox["\[Tau]p", "2"]}], " ", "=", " ", 
    RowBox[{
     SuperscriptBox["\[Tau]m", "2"], " ", "as", " ", "well"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"iZeroMOne", "[", 
    RowBox[{"p_", ",", "\[Tau]p_", ",", "\[Tau]m_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{"\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[Tau]p"}], " ", 
        RowBox[{"i", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "]"}]}], "+", 
       RowBox[{"2", " ", "d", " ", "\[Tau]m", " ", 
        RowBox[{"i", "[", 
         RowBox[{"0", ",", "0"}], "]"}]}], "+", 
       RowBox[{"\[Tau]p", " ", 
        RowBox[{"i", "[", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "]"}]}], "-", 
       RowBox[{"2", " ", "d", " ", "\[Tau]p", " ", 
        RowBox[{"i", "[", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "]"}]}], "+", 
       RowBox[{
        SuperscriptBox["p", "2"], " ", "\[Tau]p", " ", 
        RowBox[{"i", "[", 
         RowBox[{"1", ",", "1"}], "]"}]}]}], ")"}]}], 
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[Tau]m", "2"], "-", 
       SuperscriptBox["\[Tau]p", "2"]}], ")"}]}]]}], ";"}]}], "Input",
 CellChangeTimes->{{3.971883373772952*^9, 3.9718834034245377`*^9}, {
  3.9719528959456577`*^9, 3.97195291254741*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"f6396eaf-136f-481e-b05d-86e17e67afeb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Series", "[", 
  RowBox[{
   RowBox[{"iZeroMOne", "[", 
    RowBox[{"p", ",", "\[Tau]p", ",", "\[Tau]m"}], "]"}], ",", 
   RowBox[{"\[Tau]p", "->", "\[Tau]m"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.971964563893056*^9, 3.971964582513381*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"002adf1c-65d0-45cc-a123-0f8944dafbfa"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   FractionBox[
    RowBox[{"\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"i", "[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "]"}], "-", 
       RowBox[{"2", " ", "d", " ", 
        RowBox[{"i", "[", 
         RowBox[{"0", ",", "0"}], "]"}]}], "-", 
       RowBox[{"i", "[", 
        RowBox[{"1", ",", 
         RowBox[{"-", "1"}]}], "]"}], "+", 
       RowBox[{"2", " ", "d", " ", 
        RowBox[{"i", "[", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "]"}]}], "-", 
       RowBox[{
        SuperscriptBox["p", "2"], " ", 
        RowBox[{"i", "[", 
         RowBox[{"1", ",", "1"}], "]"}]}]}], ")"}]}], 
    RowBox[{"4", " ", 
     RowBox[{"(", 
      RowBox[{"\[Tau]p", "-", "\[Tau]m"}], ")"}]}]], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", 
      RowBox[{"\[Tau]p", "-", "\[Tau]m"}], "]"}], "0"],
    SeriesData[$CellContext`\[Tau]p, $CellContext`\[Tau]m, {}, -1, 0, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Tau]p, $CellContext`\[Tau]m, {Complex[0, 
      Rational[1, 4]] ($CellContext`i[-1, 1] - 
     2 $CellContext`d $CellContext`i[0, 0] - $CellContext`i[1, -1] + 
     2 $CellContext`d $CellContext`i[1, -1] - $CellContext`p^2 $CellContext`i[
      1, 1])}, -1, 0, 1],

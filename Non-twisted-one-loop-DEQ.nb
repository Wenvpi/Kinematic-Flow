     "input" -> "I_{-2,1} + I_{-1,0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5f9d1d42-ebc2-4cc0-a1a1-6d061df4ecd4"],
 ". Firstly, let us try something similar to what we did previously, which \
is, first, find an expression for ",
 Cell[BoxData[

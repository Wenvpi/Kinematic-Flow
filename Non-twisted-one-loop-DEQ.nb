Cell[TextData[{
 "Closed differential equation system for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Tau]", "+", "2"], "\[LongEqual]", 
         SubsuperscriptBox["\[Tau]", "-", "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\tau_+^2 = \\tau_-^2", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4eefdede-abf7-4cd1-aef4-ef6d6c710453"]
}], "Section",
 CellChangeTimes->{{3.971883450832955*^9, 
  3.971883460197163*^9}},ExpressionUUID->"45f94f80-3106-40d9-99cc-\
f05e40b01f8f"],

Cell[TextData[{
 StyleBox["In this section we will focus exclusively in the case ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Tau]", "+"], "\[LongEqual]", 
         SubscriptBox["\[Tau]", "-"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\tau_+ = \\tau_-", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"5f9bea9e-2b8f-4b85-834b-e045549461f4"]
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.97187677339985*^9, 3.971876799820122*^9}, {
  3.971952732666193*^9, 3.971952755088851*^9}},
 Background->RGBColor[
  1., 0.941, 0.],ExpressionUUID->"6eaa485d-81f9-4d4b-9cc7-942a50b745ee"],

Cell[TextData[{
 "From the expressions for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["I", "TI"], 
        RowBox[{"-1", ",", "0"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "I_{-1,0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9b6ac877-2e11-43e6-a300-d3b584b0dc46"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["I", "TI"], 
        RowBox[{"0", ",", "-1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "I_{0,-1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c277f6fd-ced9-4b15-a13b-3da7618f69da"],
 ", we realized we have to consider independently the case ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Tau]", "+"], "\[LongEqual]", 
         SubscriptBox["\[Tau]", "-"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\tau_+ = \\tau_-", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4c7e1ae9-ffb9-45fb-9a6e-3b3f32079997"],
 ". However, we still need expression for these ",
 StyleBox["spurious",
  FontSlant->"Italic"],
 " integrals, in terms of actual master integrals."
}], "Text",
 CellChangeTimes->{{3.971883492810235*^9, 
  3.971883578468708*^9}},ExpressionUUID->"9f9742f1-ea9a-405f-8f25-\
6a3777013bbd"],

Cell["\<\
Let us define our total derivative relations again, but considering the \
time-dependence\
\>", "Text",
 CellChangeTimes->{{3.9718835804585*^9, 
  3.971883606227055*^9}},ExpressionUUID->"04a4eb38-9abb-4a85-917f-\
ed9afaff70bc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"TotalDerivative1Time", "[", 
    RowBox[{"n1_", ",", "n2_", ",", "\[Tau]p_", ",", "\[Tau]m_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"d", "-", "n1", "-", 
       FractionBox["n2", "2"]}], ")"}], 
     RowBox[{"i", "[", 
      RowBox[{"n1", ",", "n2"}], "]"}]}], "+", 
    RowBox[{"I", "*", "\[Tau]p", "*", 
     RowBox[{"i", "[", 
      RowBox[{
       RowBox[{"n1", "-", "1"}], ",", "n2"}], "]"}]}], "+", 
    RowBox[{"I", "*", 
     FractionBox["\[Tau]m", "2"], 
     RowBox[{"i", "[", 
      RowBox[{"n1", ",", 
       RowBox[{"n2", "-", "1"}]}], "]"}]}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox["p", "2"], "*", "n2"}], "2"], 
     RowBox[{"i", "[", 
      RowBox[{"n1", ",", 
       RowBox[{"n2", "+", "2"}]}], "]"}]}], "-", 
    RowBox[{"I", "*", 
     FractionBox[
      RowBox[{
       SuperscriptBox["p", "2"], "*", "\[Tau]m"}], "2"], 
     RowBox[{"i", "[", 
      RowBox[{"n1", ",", 
       RowBox[{"n2", "+", "1"}]}], "]"}]}], "-", 
    RowBox[{
     FractionBox["n2", "2"], 
     RowBox[{"i", "[", 
      RowBox[{
       RowBox[{"n1", "-", "2"}], ",", 
       RowBox[{"n2", "+", "2"}]}], "]"}]}], "+", 
    RowBox[{"I", "*", 
     FractionBox["\[Tau]m", "2"], 
     RowBox[{"i", "[", 
      RowBox[{
       RowBox[{"n1", "-", "2"}], ",", 
       RowBox[{"n2", "+", "1"}]}], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TotalDerivative2Time", "[", 
    RowBox[{"n1_", ",", "n2_", ",", "\[Tau]p_", ",", "\[Tau]m_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"d", "-", 
       FractionBox["n1", "2"], "-", "n2"}], ")"}], 
     RowBox[{"i", "[", 
      RowBox[{"n1", ",", "n2"}], "]"}]}], "+", 
    RowBox[{"I", "*", "\[Tau]m", "*", 
     RowBox[{"i", "[", 
      RowBox[{"n1", ",", 
       RowBox[{"n2", "-", "1"}]}], "]"}]}], "+", 
    RowBox[{"I", "*", 
     FractionBox["\[Tau]p", "2"], 
     RowBox[{"i", "[", 
      RowBox[{
       RowBox[{"n1", "-", "1"}], ",", "n2"}], "]"}]}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox["p", "2"], "*", "n1"}], "2"], 
     RowBox[{"i", "[", 
      RowBox[{
       RowBox[{"n1", "+", "2"}], ",", "n2"}], "]"}]}], "-", 
    RowBox[{"I", "*", 
     FractionBox[
      RowBox[{
       SuperscriptBox["p", "2"], "*", "\[Tau]p"}], "2"], 
     RowBox[{"i", "[", 
      RowBox[{
       RowBox[{"n1", "+", "1"}], ",", "n2"}], "]"}]}], "-", 
    RowBox[{
     FractionBox["n2", "2"], 
     RowBox[{"i", "[", 
      RowBox[{
       RowBox[{"n1", "+", "2"}], ",", 
       RowBox[{"n2", "-", "2"}]}], "]"}]}], "+", 
    RowBox[{"I", "*", 
     FractionBox["\[Tau]p", "2"], 
     RowBox[{"i", "[", 
      RowBox[{
       RowBox[{"n1", "+", "1"}], ",", 
       RowBox[{"n2", "-", "2"}]}], "]"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.971883617197418*^9, 3.9718836408613157`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"80d7228b-8ed4-4df7-b15a-afd110556c82"],


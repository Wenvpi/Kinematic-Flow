     RowBox[{"\[Psi]", "[", 
      RowBox[{
       RowBox[{"n1", "-", "1"}], ",", "n2", ",", "sa", ",", 
       RowBox[{"sb", "-", "1"}]}], "]"}]}], "+", 
    RowBox[{
     FractionBox["I", "2"], "*", 
     RowBox[{"\[Psi]", "[", 
